# syntax=docker/dockerfile:1

ARG NODE_IMAGE=docker.io/library/node:22-alpine

FROM ${NODE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/wl4g-games/mycf" \
      org.opencontainers.image.title="Toon Strike WebSocket Server"

WORKDIR /app
ENV NODE_ENV=production \
    MYCF_WS_HOST=0.0.0.0 \
    PORT=8080

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY src ./src

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["node", "src/standalone.js"]
